# Streetwise — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to /etc/streetwise.env on your Oracle Cloud server
# then fill in your real values.
#
# File permissions must be 600 (readable only by root):
#   sudo chmod 600 /etc/streetwise.env
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic API key — from https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Google Gemini API key — from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza-REPLACE_ME

# Dashboard access token — choose any secret string
# Anyone who knows this token can access your dashboard
# Example: barrons2026  or  streetwise-home-99
STREETWISE_TOKEN=REPLACE_ME

# Optional: Flask host/port overrides (defaults shown)
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
