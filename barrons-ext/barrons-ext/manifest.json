{
  "manifest_version": 3,
  "name": "Barrons → Streetwise",
  "version": "1.2",
  "description": "Send the current Barron's article to your Streetwise dashboard for automatic ticker extraction.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "windows",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "http://100.*.*.*/*",
    "https://*.trycloudflare.com/*",
    "https://*.ngrok-free.app/*",
    "https://*.ngrok.app/*",
    "https://www.barrons.com/*",
    "https://barrons.com/*",
    "https://*.barrons-watchlist-research.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icon16.png",
      "48":  "icon48.png",
      "128": "icon128.png"
    }
  }
}
