# ── Streetwise Terminal — API keys template ───────────────────────────────────
# Copy this file to ".env" in the same folder and fill in your keys.
#
#   cp env.example .env
#   nano .env          # (or edit in VS Code / Notepad)
#
# server.py loads .env automatically on startup.
# Keys already set in your shell environment take priority.

ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
PERPLEXITY_API_KEY=pplx-...
FINNHUB_API_KEY=
EXA_API_KEY=

# Uncomment + set to password-protect the dashboard (remote/cloud deployments)
# STREETWISE_TOKEN=your-secret-token
